description: "CI/CD and environment separation. Apply when editing workflows, Docker, or deploy config."
globs:
  - "**/.github/workflows/**/*"
  - "**/Dockerfile*"
  - "**/docker-compose*.*"
  - "**/vercel.json"
  - "**/netlify.toml"
  - "**/railway.*"
alwaysApply: false
