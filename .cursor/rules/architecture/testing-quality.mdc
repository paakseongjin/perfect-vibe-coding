description: "Test pyramid and quality gates. Apply when editing tests or adding testable business logic."
globs:
  - "**/*.{test,spec}.{ts,tsx,js,jsx}"
  - "**/e2e/**/*"
  - "**/tests/**/*"
  - "**/__tests__/**/*"
